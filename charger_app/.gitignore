# Flutter/Dart generated
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
dist/

# Android generated (GitHub Actions creates these fresh each build)
android/.gradle/
android/gradle/
android/gradle.properties
android/gradlew
android/gradlew.bat
android/local.properties
android/settings.gradle
android/build.gradle
android/app/build.gradle
android/app/src/main/kotlin/
android/app/src/main/java/

# iOS (not used)
ios/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Kotlin-DSL Gradle files — Flutter 3.2x+ emits these instead of the Groovy
# ones above; regenerated by `flutter create` in CI.
android/settings.gradle.kts
android/build.gradle.kts
android/app/build.gradle.kts

# Android resources: `flutter create` writes the styles/launch background and
# `flutter_launcher_icons` writes the mipmaps, both fresh on every CI build.
# AndroidManifest.xml is NOT generated — it is checked in deliberately.
android/app/src/main/res/

# Signing material — never commit
android/key.properties
android/app/*.jks
